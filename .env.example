# Copia este archivo a .env y rellena los valores. .env está en .gitignore.

# --- Obligatorio ------------------------------------------------------------
# URL de la agenda de citas de Google Calendar.
# No tiene valor por defecto en el código a propósito: con este enlace
# cualquiera puede reservar, así que no se guarda en el repo.
SCHEDULE_URL=https://calendar.google.com/calendar/appointments/schedules/TU_ID_AQUI

# Token que te da @BotFather al crear el bot.
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Tu chat id: escríbele a tu bot y abre
# https://api.telegram.org/bot<TOKEN>/getUpdates -> result[0].message.chat.id
TELEGRAM_CHAT_ID=123456789

# --- Opcional ----------------------------------------------------------------
# Meses a revisar ADEMÁS del actual. 2 = mes actual + 2 siguientes.
MONTHS_AHEAD=2

# Fechas a ignorar, YYYY-MM-DD separadas por coma.
# Útil para días en los que ya tienes clase agendada.
EXCLUDE_DATES=2026-11-24,2026-11-25

# Título que aparece en el mensaje de Telegram.
# SCHEDULE_TITLE=Mi agenda

# Ruta del archivo de estado. Por defecto, state.json junto a monitor.js.
# STATE_FILE=./state.json
